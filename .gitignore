# Allowlist-oriented exclusions for generated and machine-local content.
.env
.venv/
__pycache__/
*.pyc
scratch/
build/
dist/
*.raw
*.vcd
*.fst
*.gds
*.oas
*.oasis
*.spef
*.sdf
*.log

# Transceiver block layout databases and extraction outputs are regenerated by
# each analog/<family>/run_*.sh; evidence JSON and DRC/LVS reports stay tracked.
projects/programmable_transceiver_platform/analog/*/generated/**/*.mag
projects/programmable_transceiver_platform/analog/*/generated/**/*.ext
projects/programmable_transceiver_platform/analog/*/generated/**/*.ext.spice
projects/programmable_transceiver_platform/analog/*/generated/**/*.lyrdb
projects/programmable_transceiver_platform/analog/*/generated/**/*.sim
projects/programmable_transceiver_platform/analog/*/generated/**/*.nodes
