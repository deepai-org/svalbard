* DUT source SHA-256: @DUT_SHA256@
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
@DUT_INCLUDE@
.temp @TEMP_C@

VDD VDD 0 @VDD_V@
VIP INP 0 PWL(@INP_PWL@)
VIN INN 0 PWL(@INN_PWL@)
VCLK SENSE_CLK 0 PULSE(0 @VDD_V@ 50p 20p 20p @EVAL_WIDTH_S@ 800p)
VREGEN REGEN_CLK 0 PULSE(0 @VDD_V@ @REGEN_DELAY_S@ 20p 20p @REGEN_WIDTH_S@ 800p)
VREGENB REGEN_CLKB 0 PULSE(@VDD_V@ 0 @REGEN_DELAY_S@ 20p 20p @REGEN_WIDTH_S@ 800p)
VCAPTURE CAPTURE_CLK 0 PULSE(0 @VDD_V@ @CAPTURE_DELAY_S@ 20p 20p @CAPTURE_WIDTH_S@ 800p)
VCAPTUREB CAPTURE_CLKB 0 PULSE(@VDD_V@ 0 @CAPTURE_DELAY_S@ 20p 20p @CAPTURE_WIDTH_S@ 800p)
XDUT INP INN SENSE_CLK REGEN_CLK REGEN_CLKB CAPTURE_CLK CAPTURE_CLKB VDD 0 OUTP OUTN @DUT_SUBCKT@
CLOADP OUTP 0 @CLOAD_F@
CLOADN OUTN 0 @CLOAD_F@

.control
tran 2p @TSTOP_S@
let isupply = -i(VDD)
@MEASURES@
meas tran supply_current avg isupply from=2.4n to=@TSTOP_S@
@WAVEFORM_COMMAND@
.endc
.end
