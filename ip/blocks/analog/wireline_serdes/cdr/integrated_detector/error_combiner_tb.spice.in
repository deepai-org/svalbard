.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
@DUT_INCLUDES@
.temp @TEMP_C@

.subckt composed_error_frontend DATA_P DATA_N CLK_DATA_P CLK_DATA_N CLK_EDGE_P CLK_EDGE_N VBIAS_SAMPLER VBIAS_PD VBIAS_ERROR VDD VSS ERRP ERRN
XDATA DATA_P DATA_N CLK_DATA_P CLK_DATA_N VBIAS_SAMPLER VDD VSS DATA_EVEN_P DATA_EVEN_N DATA_ODD_P DATA_ODD_N @SAMPLER_SUBCKT@
XEDGE DATA_P DATA_N CLK_EDGE_P CLK_EDGE_N VBIAS_SAMPLER VDD VSS EDGE_EVEN_P EDGE_EVEN_N EDGE_ODD_P EDGE_ODD_N @SAMPLER_SUBCKT@
XB0 DATA_ODD_P DATA_ODD_N EDGE_ODD_P EDGE_ODD_N DATA_EVEN_P DATA_EVEN_N VBIAS_PD VDD VSS E0P E0N L0P L0N @PD_SUBCKT@
XB1 DATA_EVEN_P DATA_EVEN_N EDGE_EVEN_P EDGE_EVEN_N DATA_ODD_P DATA_ODD_N VBIAS_PD VDD VSS E1P E1N L1P L1N @PD_SUBCKT@
XERROR E0P E0N L0P L0N E1P E1N L1P L1N VBIAS_ERROR VDD VSS ERRP ERRN @ERROR_SUBCKT@
.ends composed_error_frontend

VDD VDD 0 @VDD_V@
VDP DATA_P 0 PWL(@DATA_P_PWL@)
VDN DATA_N 0 PWL(@DATA_N_PWL@)
VCDP CLK_DATA_P 0 SIN(@CLOCK_CM_V@ @CLOCK_PEAK_V@ 1.25g 0 0 0)
VCDN CLK_DATA_N 0 SIN(@CLOCK_CM_V@ @CLOCK_PEAK_V@ 1.25g 0 0 180)
VCEP CLK_EDGE_P 0 SIN(@CLOCK_CM_V@ @CLOCK_PEAK_V@ 1.25g 0 0 @EDGE_PHASE_DEG@)
VCEN CLK_EDGE_N 0 SIN(@CLOCK_CM_V@ @CLOCK_PEAK_V@ 1.25g 0 0 @EDGE_N_PHASE_DEG@)
VBS VBIAS_SAMPLER 0 @VBIAS_SAMPLER_V@
VBP VBIAS_PD 0 @VBIAS_PD_V@
VBE VBIAS_ERROR 0 @VBIAS_ERROR_V@

XDUT DATA_P DATA_N CLK_DATA_P CLK_DATA_N CLK_EDGE_P CLK_EDGE_N
+ VBIAS_SAMPLER VBIAS_PD VBIAS_ERROR VDD 0 ERRP ERRN composed_error_frontend
CERRP ERRP 0 50f
CERRN ERRN 0 50f

.control
tran @TSTEP_S@ @TSTOP_S@
let err = v(ERRP)-v(ERRN)
let output_cm = (v(ERRP)+v(ERRN))/2
let isupply = -i(VDD)
@ERROR_MEASURES@
meas tran output_cm_avg avg output_cm from=@MEAS_START_S@ to=@TSTOP_S@
meas tran supply_current avg isupply from=@MEAS_START_S@ to=@TSTOP_S@
.endc
.end
