* SPDX-License-Identifier: Apache-2.0
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.include @DUT_PATH@
.temp @TEMP_C@

VDD VDD 0 PWL(0 0 500p @VDD_V@)
VSEL0 SEL0 0 PWL(0 0 500p @SEL0_V@)
VSEL1 SEL1 0 PWL(0 0 500p @SEL1_V@)
VSEL2 SEL2 0 PWL(0 0 500p @SEL2_V@)
VSEL3 SEL3 0 PWL(0 0 500p @SEL3_V@)
VCLKP CLKP 0 PULSE(0 @VDD_V@ 1n 20p 20p 380p 800p)
VCLKN CLKN 0 PULSE(@VDD_V@ 0 1n 20p 20p 380p 800p)
XDUT CLKP CLKN SEL0 SEL1 SEL2 SEL3 VDD 0 VDD VDD 0 0
+ ES EB EW OS OB OW @DUT_SUBCKT@

* Approximate the aggregate gates of one extracted regenerative interleave.
CES ES 0 350f
CEB EB 0 350f
* Capture-bar is generated locally at the consumer.  The 650 fF boundary
* includes the capture clock gates, route, and local complement-driver input.
CEW EW 0 650f
COS OS 0 350f
COB OB 0 350f
COW OW 0 650f

.control
tran 2p 12n uic
let isupply = -i(VDD)
meas tran clk_rise when v(CLKP)=@VMID@ rise=1 td=8n
meas tran es_rise when v(ES)=@VMID@ rise=1 td=8n
meas tran es_fall when v(ES)=@VMID@ fall=1 td=8n
meas tran ew_rise when v(EW)=@VMID@ rise=1 td=8n
meas tran ew_fall when v(EW)=@VMID@ fall=1 td=8n
meas tran os_rise when v(OS)=@VMID@ rise=1 td=8n
meas tran os_fall when v(OS)=@VMID@ fall=1 td=8n
meas tran ow_rise when v(OW)=@VMID@ rise=1 td=8n
meas tran ow_fall when v(OW)=@VMID@ fall=1 td=8n
meas tran es_high max v(ES) from=8n to=12n
meas tran es_low min v(ES) from=8n to=12n
meas tran ew_high max v(EW) from=8n to=12n
meas tran ew_low min v(EW) from=8n to=12n
meas tran eb_high max v(EB) from=8n to=12n
meas tran os_high max v(OS) from=8n to=12n
meas tran os_low min v(OS) from=8n to=12n
meas tran ow_high max v(OW) from=8n to=12n
meas tran ow_low min v(OW) from=8n to=12n
meas tran ob_high max v(OB) from=8n to=12n
* @DEBUG_BEGIN@
