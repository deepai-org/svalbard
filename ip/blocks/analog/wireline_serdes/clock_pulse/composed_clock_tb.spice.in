* SPDX-License-Identifier: Apache-2.0
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @PI_PEX@
.include @RESTORER_PEX@
.include @CONVERTER_PEX@
.temp @TEMP_C@

VDD VDD 0 PWL(0 0 500p @VDD_V@)
VAP A_P 0 SIN(@INPUT_CM@ 0.20 1.25g 1n 0 0)
VAN A_N 0 SIN(@INPUT_CM@ 0.20 1.25g 1n 0 180)
VBP B_P 0 SIN(@INPUT_CM@ 0.20 1.25g 1n 0 270)
VBN B_N 0 SIN(@INPUT_CM@ 0.20 1.25g 1n 0 90)
VCTRLA CTRL_A 0 PWL(0 0 500p 1.15)
VCTRLB CTRL_B 0 PWL(0 0 500p 1.15)
VPIBIAS PI_BIAS 0 PWL(0 0 500p 1.15)
VRESTBIAS REST_BIAS 0 PWL(0 0 500p @REST_BIAS@)
VCONVBIAS CONV_BIAS 0 PWL(0 0 500p @CONV_BIAS@)

XPI A_P A_N B_P B_N CTRL_A CTRL_B PI_BIAS VDD 0 RAW_P RAW_N
+ phase_interpolator_pex
XREST RAW_P RAW_N REST_BIAS VDD 0 CLK_P CLK_N
+ cml_clock_restorer_cascade_pex
XCONV CLK_P CLK_N CONV_BIAS VDD 0 CMOS_P CMOS_N
+ clock_level_converter_pex
CLOADP CMOS_P 0 100f
CLOADN CMOS_N 0 100f

.control
tran 2p 12n uic
let raw_diff = v(RAW_P)-v(RAW_N)
let clk_diff = v(CLK_P)-v(CLK_N)
let clk_cm = (v(CLK_P)+v(CLK_N))/2
let isupply = -i(VDD)
meas tran raw_high max raw_diff from=8n to=12n
meas tran raw_low min raw_diff from=8n to=12n
meas tran clk_high max clk_diff from=8n to=12n
meas tran clk_low min clk_diff from=8n to=12n
meas tran clk_cm_avg avg clk_cm from=8n to=12n
meas tran cmos_p_high max v(CMOS_P) from=8n to=12n
meas tran cmos_p_low min v(CMOS_P) from=8n to=12n
meas tran cmos_n_high max v(CMOS_N) from=8n to=12n
meas tran cmos_n_low min v(CMOS_N) from=8n to=12n
meas tran p_rise when v(CMOS_P)=@OUTPUT_MID@ rise=1 td=8n
meas tran p_fall when v(CMOS_P)=@OUTPUT_MID@ fall=1 td=8n
meas tran p_rise_next when v(CMOS_P)=@OUTPUT_MID@ rise=2 td=8n
meas tran n_rise when v(CMOS_N)=@OUTPUT_MID@ rise=1 td=8n
meas tran n_fall when v(CMOS_N)=@OUTPUT_MID@ fall=1 td=8n
meas tran supply_current avg isupply from=8n to=12n
.endc
.end
