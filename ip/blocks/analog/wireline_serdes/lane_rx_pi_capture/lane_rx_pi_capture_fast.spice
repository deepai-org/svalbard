+ O_CAPTURE_CLK O_CAPTURE_CLKB O_SENSE_BOOST VDD VSS
+ PHASE_A_P PHASE_A_N PHASE_B_P PHASE_B_N PI_CTRL_A PI_CTRL_B PI_BUF_BIAS
+ CLK_REST_BIAS PI_RAW_P PI_RAW_N
+ PI_CLK_P PI_CLK_N
+ RX_RAWP RX_RAWN RX_RESTP RX_RESTN SAMP_E_P SAMP_E_N SAMP_O_P SAMP_O_N
