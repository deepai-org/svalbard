+ PI_BUF_BIAS VDD VSS PI_RAW_P PI_RAW_N phase_interpolator
XCLKREST PI_RAW_P PI_RAW_N CLK_REST_BIAS VDD VSS PI_CLK_P PI_CLK_N
+ cml_clock_restorer_cascade
XRX RXP RXN TERM_EN0_N TERM_EN1_N TERM_EN2_N TERM_EN3_N TERM_EN4_N
+ TERM_EN5_N TERM_EN6_N VTHP VTHN RX_BIAS RX_BW_EN_N REST_BIAS
+ PI_CLK_P PI_CLK_N SAMP_BIAS E_SENSE_CLK E_REGEN_CLK E_REGEN_CLKB
