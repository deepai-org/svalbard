* SPDX-License-Identifier: Apache-2.0
* DUT SHA-256: @DUT_SHA256@
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @DUT_PATH@
.temp @TEMP_C@

VDD VDD 0 @VDD_V@
VRH VREFH 0 1.333
VRL VREFL 0 0.300
VS SWEEP 0 0
@BIT_SOURCES@
XDUT @DUT_PORTS@ VREFH VREFL 0 CTRL_A CTRL_B @DUT_SUBCKT@
CA CTRL_A 0 250f
CB CTRL_B 0 250f

.control
dc VS 0 1m 1m
let ref_power = -i(VRH)*1.333-i(VRL)*0.300
meas dc ctrl_a find v(CTRL_A) at=0
meas dc ctrl_b find v(CTRL_B) at=0
meas dc reference_power find ref_power at=0
.endc
.end
