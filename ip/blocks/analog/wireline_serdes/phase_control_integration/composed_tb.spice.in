* SPDX-License-Identifier: Apache-2.0
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @DAC_PEX@
.include @PI_PEX@
.temp @TEMP_C@
VDD VDD 0 @VDD_V@
VRH VREFH 0 1.333
VRL VREFL 0 0.300
VBUF VBIAS_BUF 0 1.15
VAP A_P 0 SIN(@VCM_V@ 0.20 1.25g 0 0 0)
VAN A_N 0 SIN(@VCM_V@ 0.20 1.25g 0 0 180)
VBP B_P 0 SIN(@VCM_V@ 0.20 1.25g 0 0 270)
VBN B_N 0 SIN(@VCM_V@ 0.20 1.25g 0 0 90)
@BIT_SOURCES@
XDAC @DAC_PORTS@ VREFH VREFL 0 CTRL_A CTRL_B phase_control_dac_pex
XPI A_P A_N B_P B_N CTRL_A CTRL_B VBIAS_BUF VDD 0 CLK_P CLK_N phase_interpolator_pex
COUTP CLK_P 0 50f
COUTN CLK_N 0 50f
.control
tran 4p 4.8n
let va_diff=v(A_P)-v(A_N)
let vb_diff=v(B_P)-v(B_N)
let vout=v(CLK_P)-v(CLK_N)
let vcm=(v(CLK_P)+v(CLK_N))/2
let isupply=-i(VDD)
meas tran phase_delay trig va_diff val=0 rise=4 targ vout val=0 rise=5
meas tran b_delay trig va_diff val=0 rise=4 targ vb_diff val=0 rise=5
meas tran diff_high max vout from=2.4n to=4.8n
meas tran diff_low min vout from=2.4n to=4.8n
meas tran output_cm avg vcm from=2.4n to=4.8n
meas tran supply_current avg isupply from=2.4n to=4.8n
meas tran duty_high trig vout val=0 rise=5 targ vout val=0 fall=5
meas tran ctrl_a avg v(CTRL_A) from=2.4n to=4.8n
meas tran ctrl_b avg v(CTRL_B) from=2.4n to=4.8n
.endc
.end
