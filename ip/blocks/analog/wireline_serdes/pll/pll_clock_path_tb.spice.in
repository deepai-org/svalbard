* SPDX-License-Identifier: Apache-2.0
* Full-RC routed VCO-bank/restorer/divider parent calibration.
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @PARENT_PEX_PATH@
.temp @TEMP_C@

VCORE VDD 0 PWL(0 0 500p @VDD_V@)
VREFH VREFH 0 PWL(0 0 500p 2.0)
VREFL VREFL 0 0
VRESTBIAS REST_BIAS 0 PWL(0 0 500p @REST_BIAS_V@)
VDIVBIAS DIV_BIAS 0 PWL(0 0 500p @DIV_BIAS_V@)
VRESET DIV_RESET 0 PWL(0 0 4n @VDD_V@ 4.1n 0)
@BIT_SOURCES@
VFKP FAST_KICKP 0 @FAST_KICKP_SOURCE@
VFKN FAST_KICKN 0 @FAST_KICKN_SOURCE@
VGKP GAIN_KICKP 0 @GAIN_KICKP_SOURCE@
VGKN GAIN_KICKN 0 @GAIN_KICKN_SOURCE@
VSELA SEL_A 0 @SEL_A_SOURCE@
VSELB SEL_B 0 @SEL_B_SOURCE@
VSELBUF SEL_BUF 0 PWL(0 0 3n 0 3.1n 1.35)

XPATH VREFH VREFL VDD 0 @DUT_CODE_PORTS@
+ FAST_KICKP FAST_KICKN GAIN_KICKP GAIN_KICKN SEL_A SEL_B SEL_BUF
+ REST_BIAS DIV_RESET DIV_BIAS DIV_P DIV_N pll_clock_path_pex
CLOADP DIV_P 0 50f
CLOADN DIV_N 0 50f

.control
tran 3p 32n
let bank_diff=v(XPATH.XREST.IN_P)-v(XPATH.XREST.IN_N)
let rest_diff=v(XPATH.XREST.OUT_P)-v(XPATH.XREST.OUT_N)
let div_diff=v(DIV_P)-v(DIV_N)
let div_cm=(v(DIV_P)+v(DIV_N))/2
let itotal=-i(VCORE)
let reference_power=-v(VREFH)*i(VREFH)
meas tran bank_startup when bank_diff=0 rise=1 td=3.1n
meas tran bank_period trig bank_diff val=0 rise=1 td=24n
+ targ bank_diff val=0 rise=2 td=24n
meas tran bank_high max bank_diff from=24n to=32n
meas tran bank_low min bank_diff from=24n to=32n
meas tran rest_high max rest_diff from=24n to=32n
meas tran rest_low min rest_diff from=24n to=32n
meas tran div_startup when div_diff=0 rise=1 td=4.1n
meas tran div_period_early trig div_diff val=0 rise=1 td=16n
+ targ div_diff val=0 rise=2 td=16n
meas tran div_period_late trig div_diff val=0 rise=1 td=24n
+ targ div_diff val=0 rise=2 td=24n
meas tran div_high_time trig div_diff val=0 rise=1 td=24n
+ targ div_diff val=0 fall=1 td=24n
meas tran div_high max div_diff from=24n to=32n
meas tran div_low min div_diff from=24n to=32n
meas tran div_output_cm avg div_cm from=24n to=32n
meas tran total_current avg itotal from=24n to=32n
meas tran reference_power_avg avg reference_power from=24n to=32n
print bank_startup bank_period bank_high bank_low rest_high rest_low
+ div_startup div_period_early div_period_late div_high_time div_high div_low
+ div_output_cm total_current reference_power_avg
.endc
.end
