* SPDX-License-Identifier: Apache-2.0
* Exact selected-bank parent PEX with realizable DAC-code calibration.
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @PEX_PATH@
.temp @TEMP_C@

VDD VDD 0 PWL(0 0 500p @VDD_V@)
VREFH VREFH 0 PWL(0 0 500p 2.0)
VREFL VREFL 0 0
@BIT_SOURCES@
VFKP FAST_KICKP 0 @FAST_KICKP_SOURCE@
VFKN FAST_KICKN 0 @FAST_KICKN_SOURCE@
VGKP GAIN_KICKP 0 @GAIN_KICKP_SOURCE@
VGKN GAIN_KICKN 0 @GAIN_KICKN_SOURCE@
VSELA SEL_A 0 @SEL_A_SOURCE@
VSELB SEL_B 0 @SEL_B_SOURCE@
VSELBUF SEL_BUF 0 PWL(0 0 3n 0 3.1n 1.35)

XDUT VREFH VREFL VDD 0 @DUT_CODE_PORTS@ FAST_KICKP FAST_KICKN
+ GAIN_KICKP GAIN_KICKN SEL_A SEL_B SEL_BUF CLK_P CLK_N vco_bank_top_pex
COUTP CLK_P 0 50f
COUTN CLK_N 0 50f

.control
tran 3p 20n
let vdiff = v(CLK_P)-v(CLK_N)
let vcm = (v(CLK_P)+v(CLK_N))/2
let isupply = -i(VDD)
let reference_power = -v(VREFH)*i(VREFH)
meas tran startup_time when vdiff=0 rise=1 td=3.1n
meas tran period_early trig vdiff val=0 rise=4 td=3.1n
+ targ vdiff val=0 rise=5 td=3.1n
meas tran period_late trig vdiff val=0 rise=1 td=14n
+ targ vdiff val=0 rise=2 td=14n
meas tran diff_high max vdiff from=14n to=20n
meas tran diff_low min vdiff from=14n to=20n
meas tran output_cm avg vcm from=14n to=20n
meas tran supply_current avg isupply from=14n to=20n
meas tran reference_power_avg avg reference_power from=14n to=20n
print startup_time period_early period_late diff_high diff_low output_cm
+ supply_current reference_power_avg
.endc
.end
