* SPDX-License-Identifier: Apache-2.0
* Exact selected-bank parent PEX under bounded VDD and bias-reference ripple.
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @PEX_PATH@
.temp @TEMP_C@

VVDD_BASE VDD_BASE 0 PWL(0 0 500p @VDD_V@)
VVDD_RIPPLE VDD VDD_BASE SIN(0 @VDD_RIPPLE_V@ @VDD_RIPPLE_HZ@ 500p 0 @VDD_PHASE_DEG@)
VREF_BASE VREF_BASE 0 PWL(0 0 500p 2.0)
VREF_RIPPLE VREFH VREF_BASE SIN(0 @REF_RIPPLE_V@ @REF_RIPPLE_HZ@ 500p 0 @REF_PHASE_DEG@)
VREFL VREFL 0 0
@BIT_SOURCES@
VFKP FAST_KICKP 0 @FAST_KICKP_SOURCE@
VFKN FAST_KICKN 0 @FAST_KICKN_SOURCE@
VGKP GAIN_KICKP 0 @GAIN_KICKP_SOURCE@
VGKN GAIN_KICKN 0 @GAIN_KICKN_SOURCE@
VSELA SEL_A 0 @SEL_A_SOURCE@
VSELB SEL_B 0 @SEL_B_SOURCE@
VSELBUF SEL_BUF 0 PWL(0 0 3n 0 3.1n 1.35)

XDUT VREFH VREFL VDD 0 @DUT_CODE_PORTS@ FAST_KICKP FAST_KICKN
+ GAIN_KICKP GAIN_KICKN SEL_A SEL_B SEL_BUF CLK_P CLK_N vco_bank_top_pex
COUTP CLK_P 0 50f
COUTN CLK_N 0 50f

.control
tran 3p 24n
let vdiff = v(CLK_P)-v(CLK_N)
let vcm = (v(CLK_P)+v(CLK_N))/2
let isupply = -i(VVDD_BASE)
let reference_power = -v(VREFH)*i(VREF_BASE)
meas tran startup_time when vdiff=0 rise=1 td=3.1n
@CROSSING_MEASURES@
meas tran diff_high max vdiff from=12n to=24n
meas tran diff_low min vdiff from=12n to=24n
meas tran output_cm avg vcm from=12n to=24n
meas tran supply_current avg isupply from=12n to=24n
meas tran reference_power_avg avg reference_power from=12n to=24n
print startup_time @CROSSING_NAMES@ diff_high diff_low output_cm
+ supply_current reference_power_avg
.endc
.end
