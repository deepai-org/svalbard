* SPDX-License-Identifier: Apache-2.0
* Exact VCO/divider PEX composition with a candidate CML clock restorer.
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
.include @VCO_PEX_PATH@
.include @DIVIDER_PEX_PATH@
.include @RESTORER_MODEL_PATH@
.temp @TEMP_C@

VVCO VDD_VCO 0 PWL(0 0 500p @VDD_V@)
VREST VDD_REST 0 PWL(0 0 500p @VDD_V@)
VDIV VDD_DIV 0 PWL(0 0 500p @VDD_V@)
VREFH VREFH 0 PWL(0 0 500p 2.0)
VREFL VREFL 0 0
VRESTBIAS REST_BIAS 0 PWL(0 0 500p @REST_BIAS_V@)
VDIVBIAS DIV_BIAS 0 PWL(0 0 500p @DIV_BIAS_V@)
VRESET RESET 0 PWL(0 0 4n @VDD_V@ 4.1n 0)
@BIT_SOURCES@
VFKP FAST_KICKP 0 @FAST_KICKP_SOURCE@
VFKN FAST_KICKN 0 @FAST_KICKN_SOURCE@
VGKP GAIN_KICKP 0 @GAIN_KICKP_SOURCE@
VGKN GAIN_KICKN 0 @GAIN_KICKN_SOURCE@
VSELA SEL_A 0 @SEL_A_SOURCE@
VSELB SEL_B 0 @SEL_B_SOURCE@
VSELBUF SEL_BUF 0 PWL(0 0 3n 0 3.1n 1.35)

XVCO VREFH VREFL VDD_VCO 0 @DUT_CODE_PORTS@ FAST_KICKP FAST_KICKN
+ GAIN_KICKP GAIN_KICKN SEL_A SEL_B SEL_BUF CLK_P CLK_N vco_bank_top_pex
XREST CLK_P CLK_N REST_BIAS VDD_REST 0 REST_P REST_N @RESTORER_SUBCKT@ @RESTORER_PARAMS@
XDIV REST_P REST_N RESET DIV_BIAS VDD_DIV 0 DIV_P DIV_N cml_divider_by_2_pex
CLOADP DIV_P 0 50f
CLOADN DIV_N 0 50f

.control
tran 3p 24n
let vco_diff=v(CLK_P)-v(CLK_N)
let rest_diff=v(REST_P)-v(REST_N)
let div_diff=v(DIV_P)-v(DIV_N)
let div_cm=(v(DIV_P)+v(DIV_N))/2
let ivco=-i(VVCO)
let irest=-i(VREST)
let idiv=-i(VDIV)
meas tran vco_startup when vco_diff=0 rise=1 td=3.1n
meas tran vco_period trig vco_diff val=0 rise=1 td=16n targ vco_diff val=0 rise=2 td=16n
meas tran vco_high max vco_diff from=16n to=24n
meas tran vco_low min vco_diff from=16n to=24n
meas tran rest_high max rest_diff from=16n to=24n
meas tran rest_low min rest_diff from=16n to=24n
meas tran div_startup when div_diff=0 rise=1 td=4.1n
meas tran div_period_early trig div_diff val=0 rise=2 td=6n targ div_diff val=0 rise=3 td=6n
meas tran div_period_late trig div_diff val=0 rise=1 td=16n targ div_diff val=0 rise=2 td=16n
meas tran div_high_time trig div_diff val=0 rise=1 td=16n targ div_diff val=0 fall=1 td=16n
meas tran div_high max div_diff from=16n to=24n
meas tran div_low min div_diff from=16n to=24n
meas tran div_output_cm avg div_cm from=16n to=24n
meas tran vco_current avg ivco from=16n to=24n
meas tran restorer_current avg irest from=16n to=24n
meas tran div_current avg idiv from=16n to=24n
print vco_startup vco_period vco_high vco_low rest_high rest_low div_startup
+ div_period_early div_period_late div_high_time div_high div_low div_output_cm
+ vco_current restorer_current div_current
.endc
.end
