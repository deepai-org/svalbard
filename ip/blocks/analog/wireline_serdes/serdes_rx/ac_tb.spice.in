.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @MOS_CORNER@
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice @RES_CORNER@
@DUT_INCLUDE@
.temp @TEMP_C@

VDD VDD 0 @VDD_V@
VINP RXP 0 DC @VCM_V@ AC 0.5
VINN RXN 0 DC @VCM_V@ AC -0.5
VTHP VTHP 0 @VCM_V@
VTHN VTHN 0 @VCM_V@
VBIAS VBIAS 0 @VBIAS_V@
VBW BW_EN_N 0 @BW_CODE_V@
XDUT RXP RXN VTHP VTHN VBIAS BW_EN_N VDD 0 OUTP OUTN @DUT_SUBCKT@
COUTP OUTP 0 @CLOAD_F@
COUTN OUTN 0 @CLOAD_F@

.control
op
let output_cm = (v(OUTP)+v(OUTN))/2
let stage1_cm = (@STAGE1P@+@STAGE1N@)/2
let supply_current = -i(VDD)
print output_cm stage1_cm supply_current
ac dec 100 1meg 20gig
let gain = mag(v(OUTP,OUTN))
meas ac gain_100m find gain at=100meg
meas ac gain_1p25g find gain at=1.25gig
meas ac gain_2p5g find gain at=2.5gig
meas ac gain_5g find gain at=5gig
meas ac bandwidth when gain=gain_100m*0.707 fall=1
print gain_100m gain_1p25g gain_2p5g gain_5g bandwidth
.endc
.end
