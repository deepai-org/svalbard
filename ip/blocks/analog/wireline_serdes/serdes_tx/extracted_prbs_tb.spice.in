* Nominal full-RC PRBS-7 waveform characterization.
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.include @PEX_PATH@
.temp 27

VVDD VDD 0 3.3
VBIAS VBIAS 0 1.20
VB0 LOAD_EN0_N 0 0
VB1 LOAD_EN1_N 0 0
VB2 LOAD_EN2_N 0 0
VB3 LOAD_EN3_N 0 0
VINP INP 0 PWL(@INP_PWL@)
VINN INN 0 PWL(@INN_PWL@)
CLOAD_P OUTP 0 50f
CLOAD_N OUTN 0 50f
XDUT INP INN OUTP OUTN VBIAS LOAD_EN0_N LOAD_EN1_N LOAD_EN2_N LOAD_EN3_N VDD 0 serdes_tx_pex

.control
set wr_singlescale
set wr_vecnames
tran 5p @TSTOP@ 0 5p
let vdiff = v(OUTN)-v(OUTP)
wrdata @WAVE_DATA@ vdiff
.endc
.end
