XDH4 T4 H4 H4B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH4 OP ON H4 H4B BN VSS pt_dac_current_bit WGT=16
XDH5 T5 H5 H5B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH5 OP ON H5 H5B BN VSS pt_dac_current_bit WGT=16
XDH6 T6 H6 H6B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH6 OP ON H6 H6B BN VSS pt_dac_current_bit WGT=16
XDH7 T7 H7 H7B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH7 OP ON H7 H7B BN VSS pt_dac_current_bit WGT=16
XDH8 T8 H8 H8B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH8 OP ON H8 H8B BN VSS pt_dac_current_bit WGT=16
XDH9 T9 H9 H9B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH9 OP ON H9 H9B BN VSS pt_dac_current_bit WGT=16
