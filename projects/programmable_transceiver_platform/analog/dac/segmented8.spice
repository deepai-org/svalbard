XDH12 T12 H12 H12B VDD VSS pt_adc_code_small_driver WEIGHT=16
XCH12 OP ON H12 H12B BN VSS pt_dac_current_bit WGT=16
XDH13 T13 H13 H13B VDD VSS pt_adc_code_small_driver WEIGHT=16
