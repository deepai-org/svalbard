XBUF VDD VSS BUF_REF BUF_BIAS TERM_VCM BUF_ENABLE buffer_compensated_flat
RREF1 VDD BUF_REF 1000.0
RREF2 BUF_REF VSS 1000.0
RBIAS1 VDD BUF_BIAS 8000.0
RBIAS2 BUF_BIAS VSS 3000.0
CLOAD TERM_VCM VSS 10p
VTERM_ENABLE REQ_TERM_ENABLE 0 PWL(0n 0 100n 0 100.1n 3.3 116n 3.3 116.1n 0 140n 0)
BCAS CASCODE 0 V=V(VDD)
VDATA DATA 0 PULSE(0 3.3 0 20p 20p 380p 800p)
VPOSTDATA POSTDATA 0 PULSE(0 3.3 400p 20p 20p 380p 800p)
VEN_TMDS REQ_EN_TMDS 0 PWL(0n 0 8n 0 8.1n 1 24n 1 24.1n 0 140n 0)
BBIAS_TMDS TMDS_BIAS 0 V=1.38*V(EN_TMDS)
BP_TMDS TMDS_P 0 V=V(DATA)*V(EN_TMDS)
BN_TMDS TMDS_N 0 V=(3.3-V(DATA))*V(EN_TMDS)
VEN_MAIN REQ_EN_MAIN 0 PWL(0n 0 100n 0 100.1n 1 116n 1 116.1n 0 140n 0)
BBIAS_MAIN MAIN_BIAS 0 V=1.3*V(EN_MAIN)
BP_MAIN MAIN_P 0 V=V(DATA)*V(EN_MAIN)
BN_MAIN MAIN_N 0 V=(3.3-V(DATA))*V(EN_MAIN)
VEN_POST REQ_EN_POST 0 PWL(0n 0 108n 0 108.1n 1 112n 1 112.1n 0 140n 0)
BBIAS_POST POST_BIAS 0 V=1.1*V(EN_POST)
BP_POST POST_P 0 V=(3.3-V(POSTDATA))*V(EN_POST)
BN_POST POST_N 0 V=V(POSTDATA)*V(EN_POST)
VEN_DETECT REQ_EN_DETECT 0 PWL(0n 0 118n 0 118.1n 1 134n 1 134.1n 0 140n 0)
BDETECTBIAS DETECT_PBIAS 0 V=V(VDD)-2.8499999999999996*V(EN_DETECT)
BDETECTEN DETECT_ENABLE 0 V=V(VDD)*V(EN_DETECT)
BTX_CONFLICT TX_CONFLICT 0 V=(((V(REQ_EN_TMDS)>.5)*(V(REQ_EN_MAIN)>.5))+((V(REQ_EN_TMDS)>.5)*(V(REQ_EN_POST)>.5))+((V(REQ_EN_TMDS)>.5)*(V(REQ_EN_DETECT)>.5))+((V(REQ_EN_TMDS)>.5)*(V(REQ_TERM_ENABLE)>1.65))+((V(REQ_EN_DETECT)>.5)*(V(REQ_EN_MAIN)>.5))+((V(REQ_EN_DETECT)>.5)*(V(REQ_EN_POST)>.5))+((V(REQ_EN_DETECT)>.5)*(V(REQ_TERM_ENABLE)>1.65))>0)
VTX_RESET TX_RESET 0 PWL(0n 0 26n 0 26.1n 3.3 31n 3.3 31.1n 0 140n 0)
VTX_QUALIFIED TX_QUALIFIED 0 3.3
BTX_VALID TX_VALID 0 V=(V(VDD)>=2.5)*(V(VDD)<=3.6)*(V(TX_RESET)<1.65)*(V(TX_QUALIFIED)>1.65)*(V(TX_CONFLICT)<.5)
BTX_MAIN EN_MAIN 0 V=V(TX_VALID)*(V(REQ_EN_MAIN)>.5)
BTX_POST EN_POST 0 V=V(TX_VALID)*(V(REQ_EN_POST)>.5)
BTX_TMDS EN_TMDS 0 V=V(TX_VALID)*(V(REQ_EN_TMDS)>.5)
BTX_DETECT EN_DETECT 0 V=V(TX_VALID)*(V(REQ_EN_DETECT)>.5)
BTX_TERM TERM_ENABLE 0 V=V(VDD)*V(TX_VALID)*(V(REQ_TERM_ENABLE)>1.65)

CREF BUF_REF VSS 1.0p
CBIAS BUF_BIAS VSS 1.0p

VBUF_REQUEST BUF_REQUEST VSS PWL(0n 0 58n 0 58.1n 3.3 118n 3.3 118.1n 0 140n 0)
BBUF_ENABLE BUF_ENABLE VSS V=V(BUF_REQUEST)*V(TX_VALID)
.control
set wr_singlescale
set wr_vecnames
tran 5p 140.0n
wrdata /home/ubuntu/svalbard/scratch/pad-buffer-compensated-precharge/connected.dat v(PAD_P) v(PAD_N) v(VDD) i(VDD) v(TERM_VCM) v(BUF_REF)
quit
.endc
.end
