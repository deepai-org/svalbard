inst atb0_leaf46 atb_leaf_f core
  NODE~CHAR_RP_MIX BUS~ATB0_LOCAL1 SEL=atb0_sw[45] VDD~VDD VSS~VSS
inst atb0_leaf47 atb_leaf_f core
