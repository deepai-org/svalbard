inst atb0_leaf54 atb_leaf_f core
  NODE~CHAR_MIM_B BUS~ATB0_LOCAL1 SEL=atb0_sw[53] VDD~VDD VSS~VSS
inst atb0_grp1 atb_grp core
  NODE~ATB0_LOCAL1 BUS~ATB0_GLOBAL SEL=atb0_grp[1] VDD~VDD VSS~VSS
inst atb0_pad atb_pad core
