  PSEL{0:2}=c_wrx_cap_psel[\1] SLIPP=c_wrx_cap_slipp SLIPM=c_wrx_cap_slipm
  DW{0:19}>- EW{0:19}>WRX_EW[\1] SLP>WRX_SLP SLM>WRX_SLM UP{0:3}>WRX_UP[\1] DN{0:3}>WRX_DN[\1]
  DX{0:39}>WRX_DX[\1] WCLK40>WRX_WCLK40 VDD~RAIL_wired_cap VSS~VSS

# ================= wired transmit (wired island) =================
# ring phases PH0/2/4/6 go straight to the serializer (analog/wired_tx/INTEGRATION.md section 2, WT25/WT26/WT29:
# benched from the extracted ring at the regulated swing). No clamp: the macro must hold c_pll_tx_en = 0 while the
# pll island is off (ring EN clamps its phase outputs).  PH1/3/5/7: matched dummy routes (D-PHLOAD)
waive wiredtx.WTX_PH\d+ first gate in pt_wiredtx is NAND(PH, serializer enable) (analog/wired_tx/wiredtx.spice:89-96); the macro must hold c_wiredtx_ser_en = 0 while the pll island is off (no clamp, per the wired TX owner, WT25). A floating phase input is then harmless; not benched
inst wiredtx pt_wiredtx wired_tx
  WTX_PH0=TXPH[0] WTX_PH90=TXPH[2] WTX_PH180=TXPH[4] WTX_PH270=TXPH[6] MODE_H=c_wiredtx_mode_h MODE_F=c_wiredtx_mode_f
  D{0:39}=wire_tx_data[\1] WORD_CLK>- WORD_CLK40>WTX_WCLK40 SER_EN=c_wiredtx_ser_en WTX_EXT=c_wiredtx_ext DX=WTX_DX
  POST_POL=c_wiredtx_post_pol EN_MAIN=TX_EN_MAIN EN_POST=TX_EN_POST ISLAND_OFF=island_off[0] IBIAS~BIAS_wiredtx
  MAIN_CODE{0:7}=c_wiredtx_main_code[\1] POST_CODE{0:7}=c_wiredtx_post_code[\1]
  CMD_MAIN_P>CMD_MAIN_P CMD_MAIN_N>CMD_MAIN_N CMD_POST_P>CMD_POST_P CMD_POST_N>CMD_POST_N
  MAIN_BIAS~TX_MAIN_BIAS POST_BIAS~TX_POST_BIAS WTX_EXT_DATA>WTX_EXT_DATA ATB_NBIAS~ATBN_wiredtx_bias ATB_PBIAS~- VDD~RAIL_wired_tx VSS~VSS
# pad attachment cells (pads owner; floorplan steer_0..5, attached_tx_interlock, term_buffer)
inst steer_{0:3} tx_steer wired_tx
  VDD~RAIL_wired_tx VSS~VSS IN=CMD_{MAIN_P,MAIN_N,POST_P,POST_N} OUT>TX_{MAIN_P,MAIN_N,POST_P,POST_N}
inst steer_{4:5} tx_steer wired_tx
  VDD~RAIL_wired_tx VSS~VSS IN=VSS OUT>-      # TMDS steering buffers: no source since WT22 (D-TMDS)
inst attached_tx_interlock tx_interlock wired_tx
  VDD~RAIL_wired_tx VSS~VSS REQ_MAIN=c_txpad_req_main REQ_POST=c_txpad_req_post REQ_TMDS=VSS REQ_DETECT=c_txpad_req_detect
  REQ_TERM=c_txpad_req_term RESET=island_off[0] QUALIFIED=island_on[0] SUPPLY_OK=s_pg_wired_tx CONFLICT>- VALID>-
  EN_MAIN>TX_EN_MAIN EN_POST>TX_EN_POST EN_TMDS>- EN_DETECT>TX_EN_DETECT EN_TERM>TX_EN_TERM
inst term_buffer term_buffer wired_tx
  VDD~RAIL_wired_tx VSS~VSS REF~TX_BUF_REF BIAS~TX_BUF_BIAS OUT~TX_TERM_VCM ENABLE=TX_EN_TERM
# buffer reference / bias are ideal sources in every pads bench (MW walk 6.3): build demand, D-TXTERM.
# DETECT_PBIAS = RAIL_wired (detect source off) until pads state a bias source (wired TX INTEGRATION.md section 4)
inst txpad_bias pt_txpad_bias wired_tx demand
  BUF_REF~TX_BUF_REF BUF_BIAS~TX_BUF_BIAS EN_TERM=TX_EN_TERM VDD~RAIL_wired_tx VSS~VSS
# USB line pre-driver (analog/wired_tx/USB-INTEGRATION.md): HS data = the serializer CMD_MAIN pair; FS/LS and chirp from the macro
inst usb_txdrv pt_usb_txdrv wired_tx
  CMD_P=CMD_MAIN_P CMD_N=CMD_MAIN_N HS_EN=c_usb_hs_en HS_DRV=c_usb_hs_drv FS_EN=c_usb_fs_en TX_DP=c_usb_tx_dp TX_DN=c_usb_tx_dn
  TX_OE=c_usb_tx_oe ISLAND_OFF=island_off[0] HS_STR{0:1}=c_usb_hs_str[\1] HS_PBIAS~HS_PBIAS HS_P>USB_HS_P HS_N>USB_HS_N
  FS_HIGH_P>USB_FS_HIGH_P FS_HIGH_N>USB_FS_HIGH_N FS_LOW_P>USB_FS_LOW_P FS_LOW_N>USB_FS_LOW_N VDD~RAIL_wired_tx VSS~VSS
inst hsbias pt_wtx_hsbias wired_tx
  IBIAS~BIAS_hsbias EN=c_hsbias_en C{0:7}=c_hsbias_c[\1] HS_PBIAS~HS_PBIAS VDD~RAIL_wired_tx VSS~VSS
# bring-up fallback control. Its external-route request (pin still named TMDS_REQUEST, decode branch == 2) must reach
# the interlock REQ_MAIN (WT28); REQ_MAIN has one pin, so the macro ORs that condition into c_txpad_req_main and the
# cell output is left open (D-TMDS: or add an OR cell on the wired rail)
inst wtx_fallback_control pt_wtx_fallback_control wired_tx
  L_BRANCH{0:1}=c_wtxfb_branch[\1] L_STATE{0:1}=c_wtxfb_state[\1] L_IDLE=c_wtxfb_idle L_STAGE_TMDS=c_wtxfb_stage_tmds
  L_EXT_ENABLE=c_wiredtx_ext ISO_wired=ISO_wired_tx FORCE_LEAF=atb0_sw[21] TMDS_REQUEST>- WIRED_ON>wired_on_ext
  FORCE_SELECTED>WTX_FORCE_SELECTED RAIL_wired~RAIL_wired_tx VDD~VDD VSS~VSS
waive (digital\.wired_on_ext|atb0_leaf22\.SEL) WIRED_ON and FORCE_SELECTED are made on the cell's core-VDD side (analog/bringup_control/build.py: bringup_inv / bringup_and on VDD)

# ================= characterization structures (analog/characterization; published cells, NOT in the v6 floorplan: D-CHAR)
inst char_atb pt_char_atb core
  {RN_LNA,RP_LNA,RN_MIX,RP_MIX,RN_SMP,RP_SMP,RN_DRV,RP_DRV,RES_A,RES_B,MIM_A,MIM_B}~CHAR_\1 VSS~VSS      # two-terminal devices, ATB codes 43-54
inst char_ro33 pt_char_ro33 debug
  EN=c_char_en[0] OUT>CHAR_RO33_CK VDD~RAIL_debug VSS~VSS
inst char_ro50 pt_char_ro50 debug
  EN=c_char_en[1] OUT>CHAR_RO50_CK VDD~RAIL_debug VSS~VSS
inst char_cmldiv pt_char_cmldiv debug
  EN=c_char_en[2] OUT>CHAR_CMLDIV_CK BIAS~- VDD~RAIL_debug VSS~VSS      # BIAS sense has no ATB code (requested by the owner)
# RF transistor with its own GSG probe pads (no bond, no chip connection) + OPEN and SHORT de-embedding frames
inst char_rffet{,_open} pt_char_rffet\1 core
  G~- D~- GND~-
inst char_rffet_short pt_char_rffet_short core
  GND~-

