// SPDX-License-Identifier: Apache-2.0
// Product contract for the staged 2.4 GHz Wi-Fi receive path.  Aether syntax is
// a design intent and evidence contract, not an implemented radio compiler.

language Aether 0.1;

quantity rf_center = 2.4 GHz;
quantity vdd_io    in interval [2.97 V, 3.63 V];
quantity temp      in interval [-40 degC, 125 degC];

discipline electrical { across voltage: V; through current: A; }
discipline thermal    { across temperature: K; through heat: W; }

ensemble gf180_public_pvt {
  process_corner in { tt, ff, ss };
  supply in vdd_io;
  temperature in temp;

  // These terms lack provider-qualified RF evidence.  They are obligations,
  // not invented statistical distributions.
  rf_device_error  unavailable "provider RF model validity";
  passive_q        unavailable "on-die and external passive characterization";
  substrate_noise  unavailable "mixed-signal aggressor/victim characterization";
  package_network  unavailable "bond/package S-parameters";
  antenna_network  unavailable "antenna, filter, and matching S-parameters";
}

module wifi_80211b_rx : radio_receiver in physical_environment {
  terminal antenna_50ohm, ext_lo, ext_i, ext_q : electrical;
  terminal vdd_rf, vss, substrate : electrical;
  terminal die_thermal : thermal;

  input enable, rx_data : event;
  output recovered_bits, rx_ready, diagnostic_fault : event;

  assume early_risk_boundary {
    // Channel selection is deliberately outside this first die macro. At the
    // present 2.300-GHz LO, a 2.400/2.425-GHz pair becomes 100/125 MHz: a
    // low-order on-die RC filter cannot reject the measured 40-dB aggressor
    // without also corrupting a wide 802.11b channel. A real receiver must
    // bind either a measured external RF preselector/matching network before
    // the LNA, or an ADC/DSP dynamic-range and channel-filtering proof.
    external antenna_50ohm through bound_channel_selectivity_network;
    external reference and LO/IQ through qualified_reference_chain;
    package, bond, and board networks are explicit imported two_port_models;
    // No on-die PA, antenna switch, crystal, bias/reference, or calibration is
    // present in the first receive-path risk macro.
  }

  module lna_core : common_source_nfet_array {
    terminal rf_in, rf_out, rf_source, vss : electrical;
    implementation intent {
      source "ip/blocks/analog/wifi_80211b/rf_lna/lna_cs_core.spice";
      physical "ip/blocks/analog/wifi_80211b/rf_lna/layout.tcl";
      degree_of_freedom { finger_order, multiplicity, placement, routing };
      forbid { topology_change, terminal_reordering };
    }
    assume bench_boundary {
      external_50ohm_source_and_matching;
      external_bias = 1.5 V;
      external_source_degeneration_and_drain_load;
      high_impedance_external_mixer_load;
    }
    guarantee checked_full_rc_pvt {
      source "ip/blocks/analog/wifi_80211b/rf_lna/run_lna_physical.sh";
      drc_clean and lvs_matches_intended_circuit;
      for every public_pvt_case { voltage_gain(rf_center) >= 1.0; }
      0.4 V <= drain_dc <= vdd_rf - 0.4 V;
      0.1 mA <= supply_current <= 20 mA;
    }
  }

  module external_lo_mixer_core : differential_switching_mixer {
    terminal rf_in, lo, lob, ifp, ifn, vss : electrical;
    implementation intent {
      source "ip/blocks/analog/wifi_80211b/rf_switch_mixer/mixer.spice";
      physical "ip/blocks/analog/wifi_80211b/rf_switch_mixer/layout.tcl";
      degree_of_freedom { finger_order, multiplicity, placement, routing };
      forbid { topology_change, terminal_reordering };
    }
    assume bench_boundary {
      external_50ohm_rf_source;
      complementary_external_lo = 2.3 GHz;
      external_differential_if_load;
    }
    guarantee checked_full_rc_pvt {
      source "ip/blocks/analog/wifi_80211b/rf_switch_mixer/run_mixer_physical.sh";
      drc_clean and lvs_matches_intended_circuit;
      for every public_pvt_case {
        finite_differential_conversion(rf_center - 2.3 GHz);
      }
      not_claim { mixer_noise_figure, linearity, isolation, i_q_balance,
                  local_oscillator, integrated_receiver };
    }
  }

  module die_side_ostl_coupon : rf_characterization_coupon {
    terminal open, load, vss : electrical;
    implementation intent {
      source "ip/blocks/analog/wifi_80211b/rf_ostl_coupon/rf_ostl_coupon.spice";
      physical "ip/blocks/analog/wifi_80211b/rf_ostl_coupon/layout.tcl";
      measurement_plan "ip/blocks/analog/wifi_80211b/rf_ostl_coupon/test_plan.json";
      standards { open, short, thru, poly_load };
    }
    guarantee checked_extracted_structure {
      source "ip/blocks/analog/wifi_80211b/rf_ostl_coupon/run_coupon_physical.sh";
      drc_clean and lvs_matches_intended_circuit and full_rc_pex;
      preserve floating_poly_body_as_measurement_obligation;
      not_claim { calibrated_load_impedance, rf_deembedding_validity,
                  production_pad, package_or_antenna_qualification };
    }
  }

  module lna_nfet_array_coupon : active_rf_characterization_coupon {
    terminal gate, drain, source, vss : electrical;
    implementation intent {
      source "ip/blocks/analog/wifi_80211b/rf_nfet_array_coupon/rf_nfet_array_coupon.spice";
      physical "ip/blocks/analog/wifi_80211b/rf_nfet_array_coupon/layout.tcl";
      measurement_plan "ip/blocks/analog/wifi_80211b/rf_nfet_array_coupon/test_plan.json";
      replica { nfet_03v3, 16 fingers, 4 um width, 0.28 um length,
                lna_core.source_drain_order };
    }
    guarantee checked_extracted_identity {
      source "ip/blocks/analog/wifi_80211b/rf_nfet_array_coupon/run_coupon_physical.sh";
      drc_clean and lvs_matches_intended_circuit and full_rc_pex;
      extracted_count(nfet_03v3, width = 4 um, length = 0.28 um) == 16;
      not_claim { rf_compact_model_validity, noise_parameters, ft_fmax,
                  linearity, production_pad, package_or_antenna_qualification };
    }
  }

  module external_lo_rx_parent : routed_receive_parent {
    terminal rf_gate, mix_rf, lna_source, lo, lob, ifp, ifn, vss : electrical;
    implementation intent {
      source "ip/blocks/analog/wifi_80211b/rf_rx_external_lo_parent/rf_rx_external_lo_parent.spice";
      physical "ip/blocks/analog/wifi_80211b/rf_rx_external_lo_parent/layout.tcl";
      children { lna_core, external_lo_mixer_core };
      parent_owned_route { lna_core.rf_out -> external_lo_mixer_core.rf_in };
    }
    assume bench_boundary {
      external_50ohm_source_and_matching;
      external_lna_bias = 1.5 V;
      external_drain_load_and_source_degeneration;
      complementary_external_lo = 2.3 GHz;
      external_differential_if_load;
    }
    guarantee checked_full_rc_pvt {
      source "ip/blocks/analog/wifi_80211b/rf_rx_external_lo_parent/run_parent_physical.sh";
      drc_clean and lvs_matches_intended_circuit;
      for every public_pvt_case {
        finite_differential_conversion(rf_center - 2.3 GHz);
      }
      not_claim { receiver_noise_figure, linearity, isolation, i_q_balance,
                  local_oscillator, integrated_receiver };
    }
    guarantee checked_fixed_two_tone_diagnostic {
      source "ip/blocks/analog/wifi_80211b/rf_rx_external_lo_parent/run_parent_physical.sh";
      for every public_pvt_case {
        observe desired = 1 mV at 2.400 GHz;
        observe aggressor = 100 mV at 2.425 GHz;
        through external_50ohm_source and external_lo = 2.300 GHz;
        measure if_desired = 100 MHz and if_aggressor = 125 MHz;
      }
      not_claim { ieee80211_blocker_tolerance, adjacent_channel_rejection,
                  receiver_linearity, receiver_sensitivity };
    }
  }

  // The staged receiver has no top-level 802.11 performance guarantee yet.
  // The following conditions are hard release blockers rather than silently
  // optimistic assumptions.
  obligation before wifi_80211b_rx.integration_claim {
    prove noise_figure, conversion_gain, i_q_balance, dc_offset,
          blocker_tolerance, phase_noise, and receive_sensitivity;
    measure die_side_ostl_coupon plus lna_nfet_array_coupon
            plus selected_passive_replicas;
    bind channel_selectivity_network from measured_or_vendor_s_parameters
         at antenna_50ohm -> external_lo_rx_parent.rf_gate;
    prove it does not double_count package_or_die_side_parasitics;
    prove either analog_blocker_headroom or adc_dsp_dynamic_range_and_filtering;
    import package_network and antenna_network with non_double_counted_em_ports;
    implement on_die_bias_reference_and_calibration with observable search;
    compose external_lo_rx_parent plus baseband through a routed physical parent;
    verify 80211b_evm, spectral_mask, startup, and coexistence_aggressors;
  }

  guarantee current_status {
    lna_core.checked_full_rc_pvt;
    external_lo_mixer_core.checked_full_rc_pvt;
    die_side_ostl_coupon.checked_extracted_structure;
    lna_nfet_array_coupon.checked_extracted_identity;
    external_lo_rx_parent.checked_full_rc_pvt;
    external_lo_rx_parent.checked_fixed_two_tone_diagnostic;
    not_claim { integrated_receiver, ieee_80211_compliance,
                interoperability, yield, silicon_qualification };
  }
}
